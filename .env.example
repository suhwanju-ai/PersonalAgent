OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_CONTEXT_WINDOW_TOKENS=128000
# Only when served through a reverse proxy: list the exact browser origin(s), comma-separated.
# Requests arriving through these origins must log in with HTTP Basic auth
# (any username, APP_ACCESS_TOKEN as the password). Without a token they are refused.
# APP_TRUSTED_ORIGINS=https://agent.example.com
# APP_ACCESS_TOKEN=
# ModelDock API key. Only needed when the ModelDock server has authentication turned on;
# without it the Authorization header is omitted. Read from .env only (restart to apply).
# MODELDOCK_API_KEY=
# Skills import folder (default: ~/.claude/skills). Read on every list/import call.
# SKILLS_IMPORT_DIR=
